# Application settings used by FastAPI and the frontend during local development.
APP_NAME=DocuMind AI
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:5173

# PostgreSQL metadata database used for documents, chunks, tasks, chats, citations, and evaluation runs.
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/documind

# Redis and Celery settings. Redis is used as the broker/result backend for async document processing.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Qdrant vector database. The base collection name is combined with provider/vector size at runtime.
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=documind_chunks

# OpenAI settings. Replace the placeholder key locally; never commit a real API key.
OPENAI_API_KEY=your_openai_api_key_here
# Embedding model used for OpenAI vector indexing.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Chat model used for answer generation and streaming responses.
OPENAI_CHAT_MODEL=gpt-4o-mini

# Ollama/local provider settings for privacy-oriented local experimentation.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Keeps local models loaded longer to reduce repeated cold starts.
OLLAMA_KEEP_ALIVE=30m

# Retrieval defaults for vector, keyword, and hybrid search behavior.
DEFAULT_RETRIEVAL_MODE=hybrid
VECTOR_TOP_K=20
BM25_TOP_K=20
RERANK_TOP_K=5
RERANKER_MODEL=BAAI/bge-reranker-base

# Chunking configuration used during document ingestion.
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Evaluation and experiment tracking settings.
MLFLOW_TRACKING_URI=http://mlflow:5000
RAGAS_EVAL_MODEL=gpt-4o-mini
